{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "task": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "task": "allow"
      }
    },
    "build-worker": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Stateless build worker for Hyperfluid. Implements spec tasks, writes tests, runs CI tools. Receives narrow task context from the build orchestrator. Same full project knowledge as the primary build agent — no specialization, just parallel execution.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "skill": "allow",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "mermaid": "allow"
    }
  }
}
